# PASP Control Center Environment Configuration

# Security
# Required: unique random value of at least 32 characters.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Role-based accounts (both are required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-admin-password
USER_USERNAME=user
USER_PASSWORD=change-user-password

# Authentication. Keep local login enabled as an emergency fallback while
# trialling Google Workspace SSO. OAuth secrets belong in runtime secrets,
# never in this file or source control.
LOCAL_LOGIN_ENABLED=true
GOOGLE_OAUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://control-center.example.com
# GOOGLE_ALLOWED_DOMAIN=example.com
# GOOGLE_ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/pasp_control_center.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pasp_control_center

# Kubeconfig Storage
KUBECONFIG_STORAGE_PATH=./kubeconfigs

# Hearth / Fournos management cluster
HEARTH_ENABLED=true
HEARTH_NAMESPACE=hearth
# HEARTH_KUBECONFIG_PATH=/absolute/path/to/management.kubeconfig

# Fournos Testing (uses the Hearth management-cluster connection)
FOURNOS_NAMESPACE=psap-automation
FOURNOS_API_GROUP=fournos.dev
FOURNOS_API_VERSION=v1
FOURNOS_JOB_PLURAL=fournosjobs
FOURNOS_K8S_TIMEOUT=30
FORGE_GITHUB_REPO=openshift-psap/forge
FORGE_GITHUB_REF=main
# GITHUB_TOKEN=github-token-for-authenticated-api-requests
GITHUB_SYNC_INTERVAL_SECONDS=3600
GITHUB_SYNC_FAILURE_BACKOFF_SECONDS=300
FOURNOS_DEFAULT_PIPELINES=forge-full,forge-prepare-test,forge-test-only,forge-prepare-only,forge-replot,nightly

# Optional read-only Jira associations for test runs. Use hostnames only in
# the allowlist; never include credentials, tokens, query strings, or issue
# paths. Jira API access is not required.
# WORK_ITEM_ALLOWED_HOSTS=jira.example.com
# WORK_ITEM_JIRA_BASE_URL=https://jira.example.com

# Billing CSV Storage
BILLING_CSV_STORAGE_PATH=./billing_csvs

# MLFlow Integration (optional)
MLFLOW_BASE_URL=https://your-mlflow-server.example.com

# API Settings
API_V1_PREFIX=/api/v1

# Logging Configuration (optional - defaults to INFO)
# Options: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO

# Frontend external navigation destinations (build-time Vite variables).
# Leave unset to hide links that are not configured in this deployment.
# VITE_PERFORMANCE_DASHBOARD_PRODUCTION_URL=https://...
# VITE_PERFORMANCE_DASHBOARD_STAGING_URL=https://...
# VITE_PSAP_REPORT_HUB_URL=https://...
# VITE_CONFIGIQ_URL=https://...
# VITE_SERVIT_STUDIO_URL=https://...
