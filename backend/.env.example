# PASP Control Center Backend Configuration

SECRET_KEY=your-secret-key-change-in-production
DATABASE_URL=sqlite+aiosqlite:///./pasp_control_center.db
KUBECONFIG_STORAGE_PATH=./kubeconfigs
MLFLOW_BASE_URL=

# Admin credentials (full access: cluster management, user management, reservations)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# User credentials (limited access: view all data, create/cancel own reservations)
USER_USERNAME=user
USER_PASSWORD=change-me

# Logging Configuration (optional - defaults to INFO)
# Options: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO
