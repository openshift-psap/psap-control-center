# PASP Control Center Backend Configuration

SECRET_KEY=your-secret-key-change-in-production
DATABASE_URL=sqlite+aiosqlite:///./pasp_control_center.db
KUBECONFIG_STORAGE_PATH=./kubeconfigs
MLFLOW_BASE_URL=

# Admin credentials (REQUIRED - server will not start without these)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# User credentials (REQUIRED - server will not start without these)
USER_USERNAME=user
USER_PASSWORD=change-me

# Optional Google Workspace SSO
LOCAL_LOGIN_ENABLED=true
GOOGLE_OAUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://control-center.example.com
# GOOGLE_ALLOWED_DOMAIN=example.com
# GOOGLE_ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Logging Configuration (optional - defaults to INFO)
# Options: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO

# Billing CSV storage path (optional - defaults to ./billing_csvs)
BILLING_CSV_STORAGE_PATH=./billing_csvs
